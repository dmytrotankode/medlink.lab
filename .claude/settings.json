{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/session-start.sh", "timeout": 600 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)", "Bash(dotnet test:*)", "Bash(dotnet run:*)", "Bash(dotnet restore:*)",
      "Bash(npm run build:*)", "Bash(npm ci:*)", "Bash(npm install:*)", "Bash(./build.sh:*)", "Bash(./run.sh:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)"
    ]
  }
}
