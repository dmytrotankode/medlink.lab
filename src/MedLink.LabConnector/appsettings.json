{
  // MedLink LIS Analyzer Connector — локальні налаштування.
  // Параметри підключення до сервера (Server:*) записує команда `setup` у data/appsettings.local.json;
  // цей файл містить значення за замовчуванням і локальні перевизначення.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Server": {
    // Базова адреса ЛІС, напр. "https://lis.example.ua" (суфікс /api/v1/lab додається автоматично)
    "BaseUrl": null,
    "ApiKey": null,
    "ConnectorId": null,
    "TimeoutSec": 30,
    "AllowInvalidCertificate": false
  },
  "Local": {
    "ConnectorName": null,
    "StatusPort": 5088,
    "DataDir": "data",
    "HeartbeatIntervalSec": 30,
    "PendingOrdersPollSec": 60,
    "ResultRetrySec": 15,
    "ResultRetryMaxSec": 300,
    "LogRetentionDays": 14,
    "LogRawTraffic": true,
    "AstmTimeoutSec": 15,
    "AstmMaxRetries": 6,
    "PacketIdleMs": 700,
    "TcpKeepAliveSec": 60,
    "TcpReconnectSec": 5,
    "SendNoOrderReply": false
  },
  "Printing": {
    // Локальний агент друку етикеток: POST http://localhost:5088/print/zpl
    // Принтер за замовчуванням — або черга ОС ("ZDesigner GK420t"), або мережевий Host:Port
    "DefaultLabelPrinter": null,
    "Host": null,
    "Port": 9100
  },
  // Повністю локальні аналізатори (працюють без сервера; перекривають серверні за Code/AnalyzerId).
  // Форма — AnalyzerConfigDto (docs/API_CONTRACT.md §3). Приклади (вимкнені):
  "Analyzers": [
    // {
    //   "analyzerId": "local:SYSMEX_XN", "code": "SYSMEX_XN", "name": "Sysmex XN-1000", "typeCode": "SYSMEXXN",
    //   "protocol": "ASTM", "autoQueryOrders": true, "orderTemplate": "SYSMEX_XN",
    //   "connection": { "mode": "TCP", "port": 5100, "isServer": true },
    //   "framing": { "checksum": true, "sleepMs": 100, "maxFrameLen": 240 },
    //   "parameterMap": [ { "analyzerCode": "WBC", "testCode": "WBC", "factor": 1.0, "offset": 0.0 } ]
    // },
    // {
    //   "analyzerId": "local:COBAS_E411", "code": "COBAS_E411", "name": "Roche Cobas e411", "typeCode": "COBAS411",
    //   "protocol": "ASTM", "autoQueryOrders": true,
    //   "connection": { "mode": "COM", "comPort": "COM1", "baudRate": 9600, "parity": "None", "dataBits": 8, "stopBits": "One", "flowControl": "None" }
    // },
    // {
    //   "analyzerId": "local:MINDRAY_BS240", "code": "MINDRAY_BS240", "name": "Mindray BS-240", "typeCode": "MINDRAY240",
    //   "protocol": "HL7", "autoQueryOrders": true,
    //   "connection": { "mode": "TCP", "host": "192.168.1.105", "port": 5600, "isServer": false }
