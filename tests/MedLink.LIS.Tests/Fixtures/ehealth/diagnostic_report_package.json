  {
    "name": "Get Diagnostic Report by id: 404 (report is not registered yet)",
    "match": {
      "method": "GET",
      "pathRegex": "/patients/[^/]+/diagnostic_reports/[^/]+$"
    },
    "responses": [
      {
        "status": 404,
        "body": {
