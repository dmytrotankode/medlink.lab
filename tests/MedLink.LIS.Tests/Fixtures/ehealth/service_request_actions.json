      "method": "PATCH",
      "pathRegex": "/patients/service_requests/[^/]+/actions/complete$"
    },
    "responses": [
      {
        "status": 200,
        "body": {
          "data": {
            "status": "pending",
            "eta": "{{now}}",
            "links": [
